# HazardWatch website (Next.js) for IBM Code Engine.
# Build from the repo root. The deploy script writes frontend/.env.production
# (NEXT_PUBLIC_VISION_API_URL etc.) before the build because Next.js bakes
# NEXT_PUBLIC_* values into the client code at build time.

FROM node:22-alpine AS base
WORKDIR /app
RUN corepack enable

FROM base AS deps
# package.json runs "prepare": "lefthook install", which needs a git repo
RUN apk add --no-cache git
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml lefthook.yml ./
COPY frontend/package.json ./frontend/package.json
RUN git init
RUN pnpm install --frozen-lockfile

FROM base AS builder
COPY --from=deps /app ./
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --dir frontend build

FROM node:22-alpine AS runner
WORKDIR /app
RUN corepack enable
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=8080 \
    HOSTNAME=0.0.0.0
COPY --from=builder /app ./
EXPOSE 8080
CMD ["pnpm", "--dir", "frontend", "start"]
