# Everything the IBM Cloud deploy scripts read. Copy to .env (repo root) and fill in.
# .env is gitignored. NEVER commit it or paste real values into chat; share secrets via a password manager.

# --- vision-service (bash vision-service/deploy.sh) -> stored in Code Engine secret "vision-secrets" ---
COS_ENDPOINT=https://s3.au-syd.cloud-object-storage.appdomain.cloud   # use your bucket's endpoint
COS_API_KEY_ID=
COS_INSTANCE_CRN=crn:v1:bluemix:public:cloud-object-storage:global:a/...::
COS_BUCKET_NAME=
# Chat (optional until valid). API key = 44 chars, project ID = 36 chars, project in Sydney with watsonx.ai Runtime linked.
WATSONX_AI_URL=https://au-syd.ml.cloud.ibm.com
WATSONX_AI_APIKEY=
WATSONX_AI_PROJECT_ID=
# WATSONX_AI_MODEL_ID=

# --- website build (bash deploy-frontend-local.sh) -> FRONTEND_ENV file, PUBLIC values only ---
# Only NEXT_PUBLIC_* lines are read; they are baked into the page and visible in the browser by design.
# NEXT_PUBLIC_VISION_API_URL is set by the script from VISION_URL.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_APP_NAME=HazardWatch
