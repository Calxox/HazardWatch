# --- watsonx chat: fill in once a valid key + project ID exist (key 44 chars, project ID 36) ---
WATSONX_AI_URL=
WATSONX_AI_APIKEY=
WATSONX_AI_PROJECT_ID=

# --- website build (public values, baked into the page) ---
