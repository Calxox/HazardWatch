# deploy.env - ONLY the values the IBM Cloud deploy scripts read. Private: do not commit or re-share.
# API:      ENV_FILE=deploy.env bash vision-service/deploy.sh
# Website:  FRONTEND_ENV=deploy.env VISION_URL=... bash deploy-frontend-local.sh

# --- vision-service (Object Storage) ---
